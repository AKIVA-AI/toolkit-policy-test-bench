{
  "schema_version": 1,
  "description": "Maps each importer's native test identifier to a finding category. Rules are tried in order; the first match wins. A pattern ending in '*' is a prefix match; otherwise the match is exact. Anything unmatched is 'uncategorized'. Edit this file or pass --categories to override it.",
  "categories": {
    "prompt_injection": "Instructions in user or retrieved content override the application's instructions.",
    "jailbreak": "The model is talked out of its safety behaviour (role-play, encoding, adversarial suffixes).",
    "system_prompt_leakage": "The model reveals its system prompt or hidden instructions.",
    "pii_leakage": "Personal data about a person is disclosed.",
    "secret_leakage": "Credentials, API keys or other secrets are disclosed.",
    "training_data_leakage": "Memorised training data is replayed.",
    "harmful_content": "Toxic, violent, sexual, self-harm, criminal or otherwise harmful output.",
    "bias": "Discriminatory or stereotyping output.",
    "misinformation": "False or unsupported claims, hallucination, overreliance.",
    "improper_output_handling": "Output that is dangerous when passed to a downstream system (XSS, SQL, shell, ANSI escapes).",
    "excessive_agency": "The model or agent takes or attempts actions beyond its authority (tools, access control, SSRF).",
    "supply_chain": "Hallucinated or malicious packages and dependencies.",
    "unbounded_consumption": "Inputs that cause runaway generation or cost.",
    "intellectual_property": "Reproduction of copyrighted or proprietary material.",
    "policy_violation": "Application-specific content policy (competitors, contracts, off-topic, impersonation).",
    "uncategorized": "No rule matched."
  },
  "sources": {
    "garak": {
      "field": "probe module and class, e.g. 'dan.Dan_11_0'",
      "reference": "https://reference.garak.ai/en/latest/probes.html",
      "rules": [
        {"match": "promptinject.*", "category": "prompt_injection"},
        {"match": "latentinjection.*", "category": "prompt_injection"},
        {"match": "encoding.*", "category": "prompt_injection"},
        {"match": "goodside.*", "category": "prompt_injection"},
        {"match": "smuggling.*", "category": "prompt_injection"},
        {"match": "dan.*", "category": "jailbreak"},
        {"match": "grandma.*", "category": "jailbreak"},
        {"match": "suffix.*", "category": "jailbreak"},
        {"match": "tap.*", "category": "jailbreak"},
        {"match": "visual_jailbreak.*", "category": "jailbreak"},
        {"match": "phrasing.*", "category": "jailbreak"},
        {"match": "dra.*", "category": "jailbreak"},
        {"match": "fitd.*", "category": "jailbreak"},
        {"match": "sata.*", "category": "jailbreak"},
        {"match": "badchars.*", "category": "jailbreak"},
        {"match": "glitch.*", "category": "jailbreak"},
        {"match": "leakreplay.*", "category": "training_data_leakage"},
        {"match": "divergence.*", "category": "training_data_leakage"},
        {"match": "apikey.*", "category": "secret_leakage"},
        {"match": "web_injection.*", "category": "improper_output_handling"},
        {"match": "ansiescape.*", "category": "improper_output_handling"},
        {"match": "exploitation.*", "category": "improper_output_handling"},
        {"match": "packagehallucination.*", "category": "supply_chain"},
        {"match": "misleading.*", "category": "misinformation"},
        {"match": "snowball.*", "category": "misinformation"},
        {"match": "realtoxicityprompts.*", "category": "harmful_content"},
        {"match": "lmrc.*", "category": "harmful_content"},
        {"match": "atkgen.*", "category": "harmful_content"},
        {"match": "continuation.*", "category": "harmful_content"},
        {"match": "donotanswer.*", "category": "harmful_content"},
        {"match": "malwaregen.*", "category": "harmful_content"},
        {"match": "av_spam_scanning.*", "category": "harmful_content"},
        {"match": "topic.*", "category": "policy_violation"}
      ]
    },
    "promptfoo": {
      "field": "test metadata pluginId, e.g. 'harmful:privacy'",
      "reference": "https://www.promptfoo.dev/docs/red-team/plugins/",
      "rules": [
        {"match": "prompt-extraction", "category": "system_prompt_leakage"},
        {"match": "indirect-prompt-injection", "category": "prompt_injection"},
        {"match": "system-prompt-override", "category": "prompt_injection"},
        {"match": "ascii-smuggling", "category": "prompt_injection"},
        {"match": "hijacking", "category": "prompt_injection"},
        {"match": "pii*", "category": "pii_leakage"},
        {"match": "harmful:privacy", "category": "pii_leakage"},
        {"match": "cross-session-leak", "category": "pii_leakage"},
        {"match": "harmful:misinformation-disinformation", "category": "misinformation"},
        {"match": "harmful:intellectual-property", "category": "intellectual_property"},
        {"match": "harmful:*", "category": "harmful_content"},
        {"match": "beavertails", "category": "harmful_content"},
        {"match": "harmbench", "category": "harmful_content"},
        {"match": "donotanswer", "category": "harmful_content"},
        {"match": "cyberseceval", "category": "prompt_injection"},
        {"match": "pliny", "category": "jailbreak"},
        {"match": "bias*", "category": "bias"},
        {"match": "politics", "category": "bias"},
        {"match": "religion", "category": "bias"},
        {"match": "hallucination", "category": "misinformation"},
        {"match": "overreliance", "category": "misinformation"},
        {"match": "divergent-repetition", "category": "training_data_leakage"},
        {"match": "shell-injection", "category": "improper_output_handling"},
        {"match": "sql-injection", "category": "improper_output_handling"},
        {"match": "excessive-agency", "category": "excessive_agency"},
        {"match": "rbac", "category": "excessive_agency"},
        {"match": "bola", "category": "excessive_agency"},
        {"match": "bfla", "category": "excessive_agency"},
        {"match": "ssrf", "category": "excessive_agency"},
        {"match": "debug-access", "category": "excessive_agency"},
        {"match": "tool-discovery", "category": "excessive_agency"},
        {"match": "mcp", "category": "excessive_agency"},
        {"match": "reasoning-dos", "category": "unbounded_consumption"},
        {"match": "contracts", "category": "policy_violation"},
        {"match": "competitors", "category": "policy_violation"},
        {"match": "imitation", "category": "policy_violation"},
        {"match": "off-topic", "category": "policy_violation"},
        {"match": "policy", "category": "policy_violation"}
      ]
    },
    "pyrit": {
      "field": "score_category (the first category that matches)",
      "reference": "https://azure.github.io/PyRIT/code/scoring/0_scoring.html",
      "rules": [
        {"match": "jailbreak", "category": "jailbreak"},
        {"match": "prompt_injection", "category": "prompt_injection"},
        {"match": "prompt-injection", "category": "prompt_injection"},
        {"match": "system_prompt", "category": "system_prompt_leakage"},
        {"match": "privacy", "category": "pii_leakage"},
        {"match": "pii", "category": "pii_leakage"},
        {"match": "secrets", "category": "secret_leakage"},
        {"match": "hate", "category": "harmful_content"},
        {"match": "violence", "category": "harmful_content"},
        {"match": "sexual", "category": "harmful_content"},
        {"match": "self_harm", "category": "harmful_content"},
        {"match": "self-harm", "category": "harmful_content"},
        {"match": "harassment", "category": "harmful_content"},
        {"match": "illegal", "category": "harmful_content"},
        {"match": "harm*", "category": "harmful_content"},
        {"match": "bias", "category": "bias"},
        {"match": "fairness", "category": "bias"},
        {"match": "misinformation", "category": "misinformation"},
        {"match": "security", "category": "improper_output_handling"},
        {"match": "insecure_code", "category": "improper_output_handling"},
        {"match": "package_hallucination", "category": "supply_chain"}
      ]
    },
    "policy-test-bench": {
      "field": "case tag 'category:<name>' first; otherwise the failure code",
      "reference": "README 'Suite checks' and 'Per-case expectations'",
      "rules": [
        {"match": "secret_detected", "category": "secret_leakage"},
        {"match": "pii_detected", "category": "pii_leakage"},
        {"match": "refusal_missing", "category": "jailbreak"},
        {"match": "invalid_json", "category": "improper_output_handling"},
        {"match": "json_schema_failed", "category": "improper_output_handling"}
      ]
    }
  }
}
